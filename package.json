{
  "name": "sviam-livekit-editor-assignment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "agent": "tsx --env-file=.env.local agent/main.ts start",
    "agent:download": "tsx --env-file=.env.local agent/main.ts download-files",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.41.1",
    "@livekit/agents": "1.8.1",
    "@livekit/agents-plugin-deepgram": "1.8.1",
    "@livekit/agents-plugin-elevenlabs": "1.8.1",
    "@livekit/agents-plugin-openai": "1.8.1",
    "@livekit/agents-plugin-silero": "1.8.1",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "livekit-client": "2.21.0",
    "livekit-server-sdk": "2.17.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
